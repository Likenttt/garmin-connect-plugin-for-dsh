# ============================================================================
# dsh-plugin-garmin-connect — Environment Variables
# ============================================================================
# Copy this file to `.env` and fill in your credentials.
#   cp .env.example .env
#
# ⚠️  NEVER commit the `.env` file to version control!
# ============================================================================

# ---------- Authentication (choose ONE method) ----------

# Method 1: Username + Password (simplest, but stores password on disk)
GARMIN_USERNAME=your-email@example.com
# ⚠️ If your password contains # or other special chars, wrap it in double quotes:
#    GARMIN_PASSWORD="my#secret!pass"
GARMIN_PASSWORD=

# Method 2: Session Token (recommended for production / shared machines)
# To obtain a token, login once with Method 1 and ask the AI agent:
# "Export my Garmin session token". It will invoke the `export_garmin_session` tool.
# Then store the output here and remove your GARMIN_PASSWORD.
# GARMIN_SESSION_TOKEN=

# ---------- Region ----------
# "global" = Garmin International (connect.garmin.com)
# "cn"     = Garmin China       (connect.garmin.cn)
GARMIN_REGION=global

# ---------- Caching ----------
# Cache TTL in seconds. Default: 300 (5 minutes).
# Set to 0 to disable caching (not recommended — may trigger rate limits).
GARMIN_CACHE_TTL=300

# ---------- Logging ----------
# Log level: debug | info | warn | error
GARMIN_LOG_LEVEL=info
