# ============================================================================
# dsh-plugin-garmin-connect — Environment Variables
# ============================================================================
# Copy this file to `.env` and fill in your credentials.
#   cp .env.example .env
#
# ⚠️  NEVER commit the `.env` file to version control!
# ============================================================================

# ---------- Authentication (choose ONE session/password method) ----------

GARMIN_USERNAME=your-email@example.com

# Recommended for MFA and multi-account use (unreleased local checkout):
# Run ONE of these yourself in a trusted local TTY. Password and verification code
# are entered with echo disabled and must not be passed through CLI flags, env vars,
# MCP tool arguments, an agent terminal, or model input.
#   npm run auth:setup -- --account personal --region global
#   npm run auth:setup -- --account personal --region cn
# Copy the session path printed by the command. The file contains OAuth
# credentials, uses mode 0600 on POSIX (Windows ACL validation is not yet
# implemented), and must never be committed or pasted
# into an AI conversation. New files bind a one-way SHA-256 digest of the
# trimmed, NFKC-normalized, lower-cased username plus region. Legacy two-field
# oauth1/oauth2 files remain readable for compatibility but have no binding check.
# The runtime no longer needs GARMIN_PASSWORD.
#
# Optional custom destination:
#   npm run auth:setup -- --account personal --region global \
#     --output /absolute/private/path/personal.session.json
# On POSIX, an existing --output parent must be owner-only (normally 0700); a
# missing parent is created owner-only. Unsafe existing parents are rejected.
GARMIN_SESSION_TOKEN_FILE=/absolute/path/to/personal.session.json

# Inline session token (supported for compatibility; a file is safer):
# GARMIN_SESSION_TOKEN=

# Legacy direct password login for an account without MFA. Do not use this for the
# interactive MFA bootstrap above or put the value in a committed file. If a
# password contains #, wrap it in double quotes: GARMIN_PASSWORD="my#secret!pass"
# GARMIN_PASSWORD=

# ---------- Region ----------
# "global" = Garmin International (connect.garmin.com)
# "cn"     = Garmin China       (connect.garmin.cn)
GARMIN_REGION=global

# ---------- FIT download ----------
# Optional unless you use download_garmin_activity_fit. There is intentionally no
# default: choose an explicit parent directory on the dsh/MCP host. If unset, FIT
# download fails before writing a file. Each result is saved as
#   <base>/GARMIN_FIT_<user-email>/<activityId>.fit
# The email component is safely normalized: normal emails remain readable, while
# unsafe filename characters are replaced. Multiple account processes may share the
# same parent. The model cannot choose a path and receives only activity ID, file name,
# size, and hash—not the parent, account directory, email, or complete local path.
# GARMIN_FIT_DOWNLOAD_DIR=/absolute/path/to/garmin-fit-parent

# ---------- Caching ----------
# Cache TTL in seconds. Default: 300 (5 minutes).
# Set to 0 to disable caching (not recommended — may trigger rate limits).
GARMIN_CACHE_TTL=300

# Garmin request timeout in milliseconds. Default: 15000 (15 seconds).
GARMIN_REQUEST_TIMEOUT_MS=15000

# ---------- Logging ----------
# Log level: debug | info | warn | error
GARMIN_LOG_LEVEL=info

# ---------- Activity detail ----------
# Default detail for get_garmin_activities:
#   compact = curated fields only (saves context tokens)
#   full    = expanded fitness and precise route/location fields (large output;
#             credentials and unrelated account/social identifiers are filtered)
# The tool accepts a per-call `detail` argument to override this default.
GARMIN_ACTIVITY_DETAIL=compact

# ---------- Integration test ----------
# Print normalized activity/health/profile details during `npm run test:integration`.
# Default false keeps output to counts/status and hides the account identifier.
GARMIN_INTEGRATION_VERBOSE=false
