# ============================================================================
# dsh-plugin-garmin-connect — Environment Variables
# ============================================================================
# Copy this file to `.env` when configuring CLI/MCP or environment-based use.
#   cp .env.example .env
# Harness can install/start without a Garmin email. Later, open the plugin's
# "Garmin 账号配置" form, choose cn/global, save that region's email, and click
# the matching login button. An email saved in plugin settings takes precedence
# over GARMIN_USERNAME. The plugin uses one active region/account at a time.
#
# ⚠️  NEVER commit the `.env` file to version control!
# ============================================================================

# ---------- Authentication and local Web bootstrap ----------

# Required for CLI/MCP authentication; optional during Harness installation.
# GARMIN_USERNAME=your-email@example.com

# Optional lowercase process/account alias used by local Web, CLI, and MCP auth
# when GARMIN_SESSION_TOKEN_FILE is omitted. The default is "default"; the
# generated owner-only path ends in accounts/<alias>.session.json.
GARMIN_ACCOUNT=default

# Harness users can configure their account in the plugin after installation.
# CLI/MCP users configure GARMIN_USERNAME, GARMIN_ACCOUNT, and GARMIN_REGION.
# Local dsh Web can use its Garmin buttons; CLI/MCP can use the
# one-shot loopback broker below. Password, MFA, and CAPTCHA stay in Garmin's
# page. The CLI may read only the expected username. Real China and International
# MFA, DI exchange, profile verification, and owner-only session persistence
# passed locally on 2026-08-29. Refresh-token rotation and broader MCP-client UX
# remain ongoing compatibility coverage, not limitations on MFA support.
#
# Installed command (choose exactly one region explicitly):
#   garmin-connect-auth serve --account personal --region global --open
#   garmin-connect-auth serve --account personal-cn --region cn --open
# `serve` requires both flags and does not infer them from GARMIN_ACCOUNT or
# GARMIN_REGION, so a two-account setup cannot silently select the wrong file.
# Source checkout (`auth:serve` already supplies --open):
#   npm run auth:serve -- --account personal --region global
#   npm run auth:serve -- --account personal-cn --region cn
# The system default browser opens a random 127.0.0.1 bridge; no Playwright or
# separate Chrome profile is used. Confirm the sanitized Garmin profile in the
# browser before the owner-only DI v2 session is committed. Login, MFA, and
# profile confirmation must finish within the bridge's 10-minute lifetime.
#
# A standalone MCP server can start without password/token variables. If an old
# GARMIN_PASSWORD remains configured and the pinned SDK reports an MFA/ticket
# challenge, the server switches to the same browser recovery flow. On the
# first missing/expired/rejected credential error, URL-elicitation-capable
# clients receive the same local bridge and a completion notification; retry the
# original tool afterward. The server never replays a write automatically. For
# older clients, run the trusted-terminal `garmin-connect-auth serve` command.
# If GARMIN_SESSION_TOKEN_FILE is explicitly set, give `serve` that same
# destination through the trusted terminal environment or `--output`; MCP
# errors never echo the path.
#
# Refresh tokens may rotate. dsh, Codex, Claude Code, and other simultaneous
# processes must each use a distinct --account/--output destination. Never copy
# or concurrently share one session file, or address it through a symlink or a
# differently cased alias. The runtime no longer needs GARMIN_PASSWORD.
#
# Optional custom destination:
#   garmin-connect-auth serve --account personal-codex --region global --open \
#     --output /absolute/private/path/personal.session.json
# On POSIX, preflight canonicalizes any safe existing link target, validates
# root/current-owned non-writable ancestors, and requires a current-euid-owned
# parent with owner write+execute and no group/other access. Missing components
# are created one at a time as 0700 before Garmin authentication opens. Reads
# enforce the same safe ancestor chain and private final-parent policy.
# On Windows, the implicit path prefers local LOCALAPPDATA over redirected
# roaming APPDATA. Keep an explicit destination beneath the current user's local
# profile/config root; UNC/network paths are unsupported. Every component below the longest
# matching Windows special-folder root must have an exact current-SID-only
# DACL; missing components are created that way, while non-exact existing
# components and reparse points are rejected. Older marker-only preview
# directories are not trusted and must be migrated.
# Optional for local Web, serve, and MCP; uncomment to choose an explicit file.
# GARMIN_SESSION_TOKEN_FILE=/absolute/path/to/personal.session.json

# Legacy diagnostics only: `garmin-connect-auth login --browser` and
# `garmin-connect-auth canary` use the optional Playwright driver. The hidden
# terminal login without --browser remains for compatibility but cannot reliably
# complete CAPTCHA/browser-only challenges.

# Inline session token (supported for compatibility; a file is safer):
# GARMIN_SESSION_TOKEN=

# Legacy direct password login for an account without MFA. Do not use this for the
# interactive MFA bootstrap above or put the value in a committed file. If a
# password contains #, wrap it in double quotes: GARMIN_PASSWORD="my#secret!pass"
# GARMIN_PASSWORD=

# ---------- Region ----------
# "global" = Garmin International (connect.garmin.com)
# "cn"     = Garmin China       (connect.garmin.cn)
GARMIN_REGION=global

# ---------- FIT download ----------
# Optional unless you use download_garmin_activity_fit. There is intentionally no
# default: choose an explicit parent directory on the dsh/MCP host. If unset, FIT
# download fails before writing a file. Each result is saved as
#   <base>/GARMIN_FIT_<cn|global>_<normalized-email>/<activityId>.fit
# The region component comes from GARMIN_REGION. The email component is safely
# normalized: normal emails remain readable, while unsafe filename characters are
# replaced. Multiple account processes—including cn/global accounts with the same
# email—may share the same parent without colliding. The model cannot choose a path
# and receives only activity ID, file name, size, and hash—not the parent, account
# directory, email, or complete local path.
# Existing GARMIN_FIT_<email> directories are not migrated automatically.
# GARMIN_FIT_DOWNLOAD_DIR=/absolute/path/to/garmin-fit-parent

# ---------- Caching ----------
# Cache TTL in seconds. Default: 300 (5 minutes).
# Set to 0 to disable caching (not recommended — may trigger rate limits).
GARMIN_CACHE_TTL=300

# Garmin request timeout in milliseconds. Default: 15000 (15 seconds).
GARMIN_REQUEST_TIMEOUT_MS=15000

# ---------- Logging ----------
# Log level: debug | info | warn | error
GARMIN_LOG_LEVEL=info

# ---------- Activity detail ----------
# Default detail for get_garmin_activities:
#   compact = curated fields only (saves context tokens)
#   full    = available expanded activity-list fields, including lap counts
#             and split summaries when Garmin supplies them; may include
#             precise route/location
#             (large output; credentials and unrelated account/social
#             identifiers are filtered)
# The tool accepts a per-call `detail` argument to override this default.
GARMIN_ACTIVITY_DETAIL=full

# ---------- Integration test ----------
# Print normalized activity/health/profile details during `npm run test:integration`.
# Default false keeps output to counts/status and hides the account identifier.
GARMIN_INTEGRATION_VERBOSE=false
