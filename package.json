{
  "name": "dsh-plugin-garmin-connect",
  "version": "0.1.4",
  "description": "A DeepSeek Harness plugin that exposes Garmin Connect fitness and health data as AI-callable tools",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "README.md",
    "README.zh-CN.md",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Likenttt/garmin-connect-plugin-for-dsh.git"
  },
  "homepage": "https://github.com/Likenttt/garmin-connect-plugin-for-dsh#readme",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:integration": "npx tsx scripts/integration-test.ts",
    "prepublishOnly": "npm run build",
    "prepare": "npx --yes --package typescript@5.9.3 tsc -p tsconfig.json"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "garmin",
    "garmin-connect",
    "fitness",
    "health",
    "cordis",
    "plugin"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "dotenv": "^16.4.0",
    "garmin-connect": "^1.6.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
