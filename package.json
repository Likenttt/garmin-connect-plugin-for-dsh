{
  "name": "dsh-plugin-garmin-connect",
  "version": "0.1.5",
  "description": "A DeepSeek Harness plugin that exposes Garmin Connect fitness and health data as AI-callable tools",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "garmin-connect-mcp": "lib/mcp.js",
    "garmin-connect-auth": "lib/auth-cli.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    ".env.example",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "TEST_REPORT.md",
    "TEST_REPORT.zh-CN.md",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Likenttt/garmin-connect-plugin-for-dsh.git"
  },
  "homepage": "https://github.com/Likenttt/garmin-connect-plugin-for-dsh#readme",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:coverage": "jest --coverage --runInBand",
    "test:integration": "tsx scripts/integration-test.ts",
    "preauth:setup": "npm run build",
    "auth:setup": "node lib/auth-cli.js login",
    "preauth:canary": "npm run build",
    "auth:canary": "node lib/auth-cli.js canary",
    "pack:smoke": "npm pack --dry-run",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "garmin",
    "garmin-connect",
    "fitness",
    "health",
    "cordis",
    "plugin",
    "dsh-plugin",
    "mcp",
    "running",
    "workout"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "axios": "1.19.0",
    "axios-cookiejar-support": "5.0.5",
    "dotenv": "^16.4.0",
    "fflate": "0.8.3",
    "garmin-connect": "1.6.2",
    "tough-cookie": "5.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "tsx": "4.23.12",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "optionalDependencies": {
    "playwright-core": "1.62.1"
  }
}
